@using System.Threading
@using System.Text
@*@implements IDisposable*@
@page "/"

<h1>CHIP-8 Emulator running in Blazor</h1>

Frame: @_updateCount
<br>
<pre style="display: inline-block; line-height: 1em; letter-spacing: -0.04em; transform: scaleX(2); transform-origin: left; border: 7px solid black; overflow: hidden;  ">@_emulatorScreenText</pre>

<br>

<div>
    <button type="button" id="btn_1" class="btn btn-info text-monospace" @onmousedown="MouseEvent1" @onmouseup="MouseEvent1">1</button>
    <button type="button" id="btn_2" class="btn btn-info text-monospace" @onmousedown="MouseEvent2" @onmouseup="MouseEvent2">2</button>
    <button type="button" id="btn_3" class="btn btn-info text-monospace" @onmousedown="MouseEvent3" @onmouseup="MouseEvent3">3</button>
    <button type="button" id="btn_C" class="btn btn-info text-monospace" @onmousedown="MouseEventC" @onmouseup="MouseEventC">C</button><br>
    <button type="button" id="btn_4" class="btn btn-info text-monospace" @onmousedown="MouseEvent4" @onmouseup="MouseEvent4">4</button>
    <button type="button" id="btn_5" class="btn btn-info text-monospace" @onmousedown="MouseEvent5" @onmouseup="MouseEvent5">5</button>
    <button type="button" id="btn_6" class="btn btn-info text-monospace" @onmousedown="MouseEvent6" @onmouseup="MouseEvent6">6</button>
    <button type="button" id="btn_D" class="btn btn-info text-monospace" @onmousedown="MouseEventD" @onmouseup="MouseEventD">D</button><br>
    <button type="button" id="btn_7" class="btn btn-info text-monospace" @onmousedown="MouseEvent7" @onmouseup="MouseEvent7">7</button>
    <button type="button" id="btn_8" class="btn btn-info text-monospace" @onmousedown="MouseEvent8" @onmouseup="MouseEvent8">8</button>
    <button type="button" id="btn_9" class="btn btn-info text-monospace" @onmousedown="MouseEvent9" @onmouseup="MouseEvent9">9</button>
    <button type="button" id="btn_E" class="btn btn-info text-monospace" @onmousedown="MouseEventE" @onmouseup="MouseEventE">E</button><br>
    <button type="button" id="btn_A" class="btn btn-info text-monospace" @onmousedown="MouseEventA" @onmouseup="MouseEventA">A</button>
    <button type="button" id="btn_0" class="btn btn-info text-monospace" @onmousedown="MouseEvent0" @onmouseup="MouseEvent0">0</button>
    <button type="button" id="btn_B" class="btn btn-info text-monospace" @onmousedown="MouseEventB" @onmouseup="MouseEventB">B</button>
    <button type="button" id="btn_F" class="btn btn-info text-monospace" @onmousedown="MouseEventF" @onmouseup="MouseEventF">F</button>
</div>

@code{
        private const string RomBase64 = "";
    //private const string RomBase64 = "";

    private Timer _updateTimer;
    private int _updateCount;
    private NoWaitEmulator _emulator;
    private MachineState _machineState;
    private string _emulatorScreenText;
    private bool[] KeysState = new bool[16];

    protected override void OnInitialized() {
        _emulator = new NoWaitEmulator();
        _machineState = new MachineState();
        _emulator.Reset(ref _machineState);
        _emulator.LoadProgram(ref _machineState, Convert.FromBase64String(RomBase64));

        _updateTimer = new Timer(state => {
            InvokeAsync(UpdateState);
        }, null, 0, (int) 1000.0 / Chip8Data.Framerate);
    }

    void MouseEvent1(MouseEventArgs e) {
        KeysState[0x1] = e.Type == "mousedown";
    }

    void MouseEvent2(MouseEventArgs e) {
        KeysState[0x2] = e.Type == "mousedown";
    }

    void MouseEvent3(MouseEventArgs e) {
        KeysState[0x3] = e.Type == "mousedown";
    }

    void MouseEvent4(MouseEventArgs e) {
        KeysState[0x4] = e.Type == "mousedown";
    }

    void MouseEvent5(MouseEventArgs e) {
        KeysState[0x5] = e.Type == "mousedown";
    }

    void MouseEvent6(MouseEventArgs e) {
        KeysState[0x6] = e.Type == "mousedown";
    }

    void MouseEvent7(MouseEventArgs e) {
        KeysState[0x7] = e.Type == "mousedown";
    }

    void MouseEvent8(MouseEventArgs e) {
        KeysState[0x8] = e.Type == "mousedown";
    }

    void MouseEvent9(MouseEventArgs e) {
        KeysState[0x9] = e.Type == "mousedown";
    }

    void MouseEvent0(MouseEventArgs e) {
        KeysState[0x0] = e.Type == "mousedown";
    }

    void MouseEventA(MouseEventArgs e) {
        KeysState[0xA] = e.Type == "mousedown";
    }

    void MouseEventB(MouseEventArgs e) {
        KeysState[0xB] = e.Type == "mousedown";
    }

    void MouseEventC(MouseEventArgs e) {
        KeysState[0xC] = e.Type == "mousedown";
    }

    void MouseEventD(MouseEventArgs e) {
        KeysState[0xD] = e.Type == "mousedown";
    }

    void MouseEventE(MouseEventArgs e) {
        KeysState[0xE] = e.Type == "mousedown";
    }

    void MouseEventF(MouseEventArgs e) {
        KeysState[0xF] = e.Type == "mousedown";
    }

    public void Dispose() {
        _updateTimer?.Dispose();
    }

    private unsafe Task UpdateState() {
        _updateCount++;

        for (int i = 0; i < 16; i++) {
            _machineState.Keys[i] = KeysState[i];
        }
        _emulator.UpdateTimers(ref _machineState);
        _emulator.Update(ref _machineState, Chip8Data.InstructionPerFrame);

        _emulatorScreenText = _emulator.ScreenText;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private unsafe class NoWaitEmulator : Emulator {
        public string ScreenText = "";

        protected override void EmulateInstruction(ref MachineState machineState, in Instruction instruction, out bool mustDraw, out bool skipAdvanceProgramCounter) {
            base.EmulateInstruction(ref machineState, in instruction, out mustDraw, out skipAdvanceProgramCounter);
    //machineState.WaitingForAnyKey = false;
        }

        protected override void Render(ref MachineState machineState) {
            base.Render(ref machineState);

            StringBuilder sb = new StringBuilder(3000);
            int pixelCount = Chip8Data.ScreenWidth * Chip8Data.ScreenHeight;
            for (int i = 0; i < pixelCount; i++) {
                if (i != 0 && i % Chip8Data.ScreenWidth == 0) {
                    sb.Append("\r\n");
                }

                sb.Append(machineState.Screen[i] == 0 ? "\u2588" : " ");
            }

            ScreenText = sb.ToString();
        }
    }

}