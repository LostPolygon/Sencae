<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>preview</LangVersion>
		<TieredPGO>true</TieredPGO>
		<Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>AnyCPU</PlatformTarget>
      <Prefer32bit>false</Prefer32bit>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.13.7" />
      <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.13.7" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Sencae.Core\Sencae.Core.csproj" />
      <ProjectReference Include="..\Sencae.SharedUtility\Sencae.SharedUtility.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Resources\nestest.nes">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
