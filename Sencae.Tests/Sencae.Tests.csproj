        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Resources\01-basics.nes" />
      <Content Include="Resources\01-basics.nes">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Sencae.Core\Sencae.Core.csproj" />
      <ProjectReference Include="..\Sencae.SharedUtility\Sencae.SharedUtility.csproj" />
      <ProjectReference Include="..\Submodules\6502.Net\Sixty502DotNet.Shared\Sixty502DotNet.Shared.csproj" />
    </ItemGroup>

